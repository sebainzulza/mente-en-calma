# Copia este archivo a .env.local y rellena con tus credenciales.
# .env.local está en .gitignore — nunca lo subas.

# OpenRouter (chat IA)
# Obtén una key gratuita en https://openrouter.ai/
OPENROUTER_API_KEY=
# Modelo opcional. Por defecto: meta-llama/llama-3.3-70b-instruct:free
# Otras opciones gratuitas validadas (ver README):
#   google/gemma-4-31b-it:free       (más estricto en seguridad, menos cálido)
#   openai/gpt-oss-20b:free          (más rápido, menos parámetros)
OPENROUTER_MODEL=

# URL pública de la app (usada por OpenRouter para el dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (auth + base de datos)
# Crea un proyecto gratis en https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email para contacto de confianza, opcional en MVP)
# https://resend.com/
RESEND_API_KEY=
