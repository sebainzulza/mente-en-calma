# Copia este archivo a .env.local y rellena con tus credenciales.
# .env.local está en .gitignore — nunca lo subas.

# OpenRouter (chat IA)
# Obtén una key gratuita en https://openrouter.ai/
OPENROUTER_API_KEY=
# Modelo opcional. Por defecto: meta-llama/llama-3.3-8b-instruct:free
# Otros gratuitos: google/gemma-2-9b-it:free, mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL=

# URL pública de la app (usada por OpenRouter para el dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (auth + base de datos)
# Crea un proyecto gratis en https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email para contacto de confianza, opcional en MVP)
# https://resend.com/
RESEND_API_KEY=
